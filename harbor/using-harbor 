Reference it in a Pod for image pulling:

spec:
  containers:
  - name: my-app
    image: ://yourdomain.com
  imagePullSecrets:
  - name: harbor-credentials


-- push image from dockerhub to harbor
docker pull someImage 
docker tag someImage:someTag 10.4.0.30/choiceDir/someImage:someTag
docker push 10.4.0.30/choiceDir/someImage:someTag
