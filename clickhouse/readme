-- install storage (on each node)
sudo mkdir -p /var/lib/keeper-data
sudo chown -R 101:101 /var/lib/keeper-data

sudo mkdir -p /var/lib/clickhouse/ch-0 /var/lib/clickhouse/ch-1 /var/lib/clickhouse/ch-2
sudo chown -R 101:101 /var/lib/clickhouse/ch-*

-- install clickhouse keeper
kubectl apply -f keeper-deployment.yaml

-- install clickhouse
kubectl apply -f clickhouse-deployment.yaml

-- check clickhouse
kubectl get pods -n clickhouse-25 -l app=clickhouse-server

-- check clickhouse connection to keeper
kubectl exec -it clickhouse-server-0 -n clickhouse-25 -- clickhouse-client

-- check clickhouse connection status to keeper
SELECT * FROM system.zookeeper WHERE path = '/'

-- check replication status
CREATE TABLE test_table_repl ON CLUSTER ch_cluster
(
    id UInt64,
    name String
)
ENGINE = ReplicatedMergeTree('/clickhouse/tables/{shard}/test_table_repl', '{replica_name}')
ORDER BY id;
